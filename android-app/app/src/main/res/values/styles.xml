         overflow (Actualiser / Changer d'hebergement). Sans elle, le menu
         etait invisible et l'utilisateur ne pouvait pas corriger l'URL. -->
    <style name="Theme.Wallet" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">#0F2C4C</item>
        <item name="colorPrimaryDark">#0A2038</item>
        <item name="colorAccent">#F0B429</item>
    </style>
</resources>
