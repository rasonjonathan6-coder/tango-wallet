# ============================================================================
# Exemple de configuration — copiez ce fichier en `.env` et remplissez les
# valeurs. Aucun secret ne doit être committé dans le dépôt.
# ============================================================================

# --- Base de données ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wallet
DB_USER=wallet
DB_PASS=wallet

# --- Sécurité application ---
# Mot de passe protégeant l'espace admin (mode web)
ADMIN_PASSWORD=changez-moi
# Clé de chiffrement des identifiants tiers
CRYPTO_KEY=changez-moi-cle-de-chiffrement

# --- Google OAuth (optionnel) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Envoi d'e-mails (optionnel : sinon repli sur mail()) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Wallet

# --- Paiement crypto (Plisio) ---
PLISIO_SECRET_KEY=

# --- Blockchain (TRC20 / BEP20) ---
TRON_API_KEY=
BSC_API_KEY=
MEGANODE_API_KEY=
ANKR_API_KEY=

# --- Tokens des scripts cron / diagnostic ---
CRON_SECRET_TOKEN=
DIAG_SECRET_TOKEN=
VIEW_LOG_SECRET_TOKEN=
FIX_SECRET_TOKEN=

# --- Notifications push (optionnel) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Application tierce ouverte après paiement ---
APP_DEEPLINK=bnc://app.binance.com
APP_FALLBACK_URL=https://www.binance.com/fr
